APP_NAME=AI Customer Support Chatbot
DEBUG=True
PORT=8000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=NLPchatbot
DATABASE_NAME=chatbot_db
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256

# Optional. If unset, the bot uses its canned replies as-is (nothing
# breaks -- see services/llm_service.py). Get a free key at
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
